# PayGuard AI — Backend Environment

APP_NAME="PayGuard AI"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://payguard:payguard@localhost:5432/payguard

# Authentication
JWT_SECRET=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
FRONTEND_URL=http://localhost:5173

# AI Provider
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Deployment Demo Account
# Set DEMO_ADMIN_PASSWORD privately in the hosting dashboard.
DEMO_MERCHANT_SLUG=demo-merchant
DEMO_MERCHANT_NAME="PayGuard Demo Merchant"
DEMO_ADMIN_EMAIL=admin@payguard.example.com
DEMO_ADMIN_PASSWORD=
